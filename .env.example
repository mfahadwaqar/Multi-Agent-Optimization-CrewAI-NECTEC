OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=replace_with_your_key

# Private time-series experiment API
EXPERIMENT_API_DATA=api_data
EXPERIMENT_API_MAX_UPLOAD_BYTES=26214400

# LANTA backend (requires non-interactive SSH key or ssh-agent authentication)
LANTA_HOST=lanta.nstda.or.th
LANTA_USERNAME=replace_with_your_username
LANTA_PROJECT_DIR=/project/YOUR_PROJECT_STORAGE/replace_with_your_username/CrewAI-rebuild
LANTA_PYTHON=.venv/bin/python
LANTA_SLURM_OPTIONS=configs/slurm_lanta.json
LANTA_TIMEOUT_SECONDS=86400
