{
  "data": {
    "source": "thai_csv",
    "name": "pathum_thani_samlae_water_level_24h",
    "path": "data/thailand/pathum_water_level.csv",
    "encodings": ["utf-8-sig", "utf-8", "cp874", "tis-620"],
    "filters": {"stn_id": "S1"},
    "timestamp_from": ["date", "time"],
    "timestamp_column": "timestamp",
    "column_map": {"wl": "water_level_m"},
    "target_column": "water_level_m",
    "feature_columns": [],
    "frequency": "10min",
    "dayfirst": false,
    "buddhist_year": false
  },
  "forecast": {
    "horizon": 144,
    "seasonality": 144,
    "lags": [1, 6, 18, 144, 1008],
    "rolling_windows": [6, 144, 1008],
    "calendar_features": ["hour", "day_of_week", "day_of_year"]
  },
  "validation": {"folds": 3, "window_size": 1008, "minimum_train_size": 10000},
  "test_fraction": 0.2,
  "random_seed": 42,
  "models": [
    {"name": "ridge", "params": {"alpha": 1.0}},
    {"name": "random_forest", "params": {"n_estimators": 150, "max_depth": 12, "min_samples_leaf": 3}}
  ]
}
